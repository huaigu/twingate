# Copy OUTSIDE the repository, e.g. /etc/signalpass/runtime.env; chmod 600.
# Exact browser HTTPS origin. No path, credentials, query or trailing slash.
APP_ORIGIN=https://signalpass.example.com

# Disabled by default. Configure all three explicitly to enable hosted drafts.
SIGNALPASS_AGENT_PROVIDER=
SIGNALPASS_AGENT_API_KEY=
SIGNALPASS_AGENT_MODEL=
SIGNALPASS_AGENT_BASE_URL=
SIGNALPASS_AGENT_TIMEOUT_MS=
SIGNALPASS_AGENT_DAILY_USER_LIMIT=20
SIGNALPASS_AGENT_DAILY_GLOBAL_LIMIT=200
