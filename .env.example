# --- Monad ---
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
DEPLOYER_PRIVATE_KEY=
# Public signer address used by Deploy.s.sol; its private key stays API-only.
QUOTE_SIGNER_ADDRESS=
TREASURY_ADDRESS=

# Contract addresses, filled in after deploy
NEXT_PUBLIC_PROFILE_REGISTRY_ADDRESS=
NEXT_PUBLIC_INTRODUCTION_ESCROW_ADDRESS=
NEXT_PUBLIC_INTRODUCTION_RECEIPT_ADDRESS=

# --- Dynamic ---
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# --- Tencent Hunyuan ---
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=
HUNYUAN_3D_ENDPOINT=

# --- Nansen ---
NANSEN_API_KEY=

# --- Evaluator ---
# mock | hunyuan
EVALUATOR_MODE=mock

# --- API service ---
# Must exactly match the browser origin (no trailing slash).
APP_ORIGIN=http://localhost:3004
# SQLite file; omit for <repo>/.data/signalpass.sqlite. Use persistent disk.
SIGNALPASS_DB_PATH=
# Server-only reverse proxy used by Next.js.
SIGNALPASS_API_ORIGIN=http://127.0.0.1:8789
API_PORT=8789
API_BASE_URL=http://localhost:8789

# --- Evaluator service ---
EVALUATOR_PORT=8788
# When set, the API delegates evaluation to the evaluator service.
# Leave empty to use the in-process mock.
EVALUATOR_URL=

# --- SignalPass hosted Personal Agent (independent of Hunyuan/evaluator) ---
# Leave provider empty to disable AI assistance while manual introductions work.
# openai | openrouter; configure a server-side account key and explicit model.
# OpenRouter currently accepts only a named vendor/model:free variant (test only).
SIGNALPASS_AGENT_PROVIDER=
SIGNALPASS_AGENT_API_KEY=
SIGNALPASS_AGENT_MODEL=
# Empty selects the provider default: api.openai.com/v1 or openrouter.ai/api/v1.
SIGNALPASS_AGENT_BASE_URL=
# Optional 1000..60000 ms; empty defaults to 15000 (OpenAI), 45000 (OpenRouter).
SIGNALPASS_AGENT_TIMEOUT_MS=
# Attempt limits are persisted per UTC day. Failed provider calls also count.
# These sponsored AI calls do not charge the user's wallet or evaluation fee.
SIGNALPASS_AGENT_DAILY_USER_LIMIT=20
SIGNALPASS_AGENT_DAILY_GLOBAL_LIMIT=200

# --- Optional wallet bonds (Hunyuan is not required) ---
# Public deployment manifest; supports local 31337 or Monad testnet 10143 only.
SIGNALPASS_CHAIN_CONFIG=
# Prefer a chmod 600 key file outside source control. Never use NEXT_PUBLIC_.
SIGNALPASS_QUOTE_SIGNER_KEY_FILE=
SIGNALPASS_QUOTE_SIGNER_PRIVATE_KEY=
# pnpm chain:dev manages a separate persistent local chain/API/web automatically.
# CHAIN_RPC_PORT=8547
# CHAIN_API_PORT=8791
# CHAIN_WEB_PORT=3005
# CHAIN_DATA_DIR=.data/local-chain

# --- Web app ---
# Read by apps/web at build time.
NEXT_PUBLIC_API_URL=http://localhost:8789
