{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "SignalPass V3 — Profile to Introduction",
    "animation": "none",
    "visual_preset": "editorial",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "profile-loop",
        "label": "建立 Profile",
        "focus": [
          "onboard",
          "profile_draft",
          "profile_review",
          "widget_snapshot"
        ],
        "note": "从社交登录和用户选择的资料来源开始，Agent 只生成草稿，用户批准后才公开。"
      },
      {
        "id": "discovery-loop",
        "label": "Agent 辅助发现",
        "focus": [
          "matching_opt_in",
          "candidate_shortlist",
          "user_select"
        ],
        "note": "Profile 是否公开和 Agent matching 独立；候选是建议，不是自动联系。"
      },
      {
        "id": "introduction-loop",
        "label": "一次 Introduction",
        "focus": [
          "user_select",
          "intro_draft",
          "consent_lock",
          "recipient_review",
          "recipient_decision",
          "outcomes"
        ],
        "note": "用户确认草稿和报价后，双方 Agent 才交换受限上下文，接收者本人做最后决定。"
      },
      {
        "id": "consent-boundary",
        "label": "权限与同意",
        "focus": [
          "profile_review",
          "matching_opt_in",
          "consent_lock",
          "recipient_decision",
          "outcomes"
        ],
        "note": "查看、推荐、起草、发送和接受是不同权限；Agent 不代替用户改变关系或资金状态。"
      }
    ],
    "output": "flow-v3.html"
  },
  "lanes": [
    {
      "id": "human",
      "label": "用户动作"
    },
    {
      "id": "profile",
      "label": "Profile 与 Widget"
    },
    {
      "id": "agent",
      "label": "Personal Agent"
    },
    {
      "id": "network",
      "label": "SignalPass 网络"
    },
    {
      "id": "recipient",
      "label": "接收者"
    },
    {
      "id": "recipient_human",
      "label": "接收者本人"
    },
    {
      "id": "outcomes",
      "label": "结果分支",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "onboarding",
      "label": "登录与资料",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "publish",
      "label": "审核与发布",
      "fromCol": 2,
      "toCol": 2,
      "variant": "security"
    },
    {
      "id": "discover",
      "label": "私有匹配与选择",
      "fromCol": 3,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "introduce",
      "label": "起草与发送",
      "fromCol": 4,
      "toCol": 4,
      "variant": "security"
    },
    {
      "id": "decide",
      "label": "接收者审核",
      "fromCol": 5,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "groups": [
    {
      "id": "profile_group",
      "label": "Public Profile / Private controls",
      "lane": "profile",
      "fromCol": 1,
      "toCol": 2,
      "variant": "default"
    },
    {
      "id": "matching_group",
      "label": "Agent-assisted discovery",
      "lane": "network",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "consent_group",
      "label": "Human confirmation gates",
      "lane": "network",
      "fromCol": 4,
      "toCol": 5,
      "variant": "security"
    },
    {
      "id": "recipient_group",
      "label": "Recipient-owned decision",
      "lane": "recipient_human",
      "fromCol": 5,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "onboard",
    "profile_draft",
    "profile_review",
    "matching_opt_in",
    "candidate_shortlist",
    "user_select",
    "intro_draft",
    "consent_lock",
    "recipient_review",
    "recipient_decision",
    "outcomes"
  ],
  "nodes": [
    {
      "id": "onboard",
      "lane": "human",
      "col": 0,
      "type": "frontend",
      "label": "登录",
      "sublabel": "链接 / Agent",
      "tag": "source",
      "width": 80,
      "height": 62
    },
    {
      "id": "profile_draft",
      "lane": "agent",
      "col": 1,
      "type": "backend",
