      "width": 80,
      "height": 62
    },
    {
      "id": "outcomes",
      "lane": "outcomes",
      "col": 5,
      "type": "backend",
      "label": "结果回执",
      "sublabel": "交接 / 补充 / 退回",
      "tag": "state + receipt",
      "width": 80,
      "height": 62
    }
  ],
  "edges": [
    {
      "id": "onboard-to-draft",
      "from": "onboard",
      "to": "profile_draft",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "draft-to-review",
      "from": "profile_draft",
      "to": "profile_review",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "review-to-matching",
      "from": "profile_review",
      "to": "matching_opt_in",
      "role": "main",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "id": "matching-to-shortlist",
      "from": "matching_opt_in",
      "to": "candidate_shortlist",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "shortlist-to-select",
      "from": "candidate_shortlist",
      "to": "user_select",
      "role": "main",
      "variant": "default",
      "fromSide": "top",
      "toSide": "bottom",
      "route": "straight"
    },
    {
      "id": "select-to-draft",
      "from": "user_select",
      "to": "intro_draft",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "draft-to-lock",
      "from": "intro_draft",
      "to": "consent_lock",
      "role": "main",
      "variant": "security"
    },
    {
      "id": "lock-to-review",
      "from": "consent_lock",
      "to": "recipient_review",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "review-to-decision",
      "from": "recipient_review",
      "to": "recipient_decision",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "decision-to-outcomes",
      "from": "recipient_decision",
      "to": "outcomes",
      "role": "main",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "V3 的核心承诺",
      "items": [
        "Profile visibility 与 Agent matching 独立",
        "私有兴趣只在双方授权时比较",
        "Agent 推荐和起草不等于已经发送",
        "Widget 只展示已批准的公开名片"
      ]
    },
    {
      "dot": "emerald",
      "title": "黑客松真实闭环",
      "items": [
        "社交登录 + GitHub / 公开链接导入",
        "Profile Draft → 用户审核 → 发布",
        "LangGraph workflow + 透明匹配理由",
        "Introduction → Recipient 决定 → Receipt"
      ]
    },
    {
      "dot": "rose",
      "title": "权限边界",
      "items": [
        "来源默认 user-provided / not verified",
        "不自动私信、发帖、点赞或接受关系",
        "Evaluation Fee 与 refundable Bond 分开",
        "私密 handoff、长期 memory 和深度宿主适配属于后续"
      ]
    }
  ]
}
