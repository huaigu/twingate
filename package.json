{
  "name": "signalpass",
  "private": true,
  "version": "0.1.0",
  "description": "SignalPass \u2014 high-signal introductions for Monad builders",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "ui:build": "pnpm --filter @signalpass/web css:build",
    "ui:check": "pnpm --filter @signalpass/web css:check",
    "test": "pnpm -r test",
    "e2e": "node scripts/e2e.mjs",
    "v4:dev": "pnpm dev",
    "v4:verify": "node scripts/v4-verify.mjs",
    "v4:flow:test": "node --test scripts/v4-flow-test.mjs",
    "agent:ui:test": "node scripts/agent-ui-test.mjs",
    "agent:refinement:test": "node --test scripts/agent-refinement-test.mjs",
    "connection:ui:test": "node scripts/connection-ui-test.mjs",
    "agent:live:test": "pnpm --filter @signalpass/api exec node --import tsx scripts/agent-live-smoke.ts",
    "agent:live:persistence:test": "pnpm --filter @signalpass/api exec node --import tsx scripts/agent-persistence-live-smoke.ts",
    "wallet:quote:test": "node --test scripts/wallet-quote-test.mjs",
    "verify": "pnpm ui:check && pnpm agent:refinement:test && pnpm v4:flow:test && pnpm wallet:quote:test && pnpm -r typecheck && pnpm -r test && pnpm e2e",
    "dev": "pnpm --parallel --filter @signalpass/api --filter @signalpass/web dev",
    "contracts:build": "pnpm --filter @signalpass/contracts build",
    "contracts:test": "pnpm --filter @signalpass/contracts test",
    "api:dev": "pnpm --filter @signalpass/api dev",
    "chain:dev": "node scripts/chain-dev.mjs",
    "chain:test": "node scripts/chain-test.mjs",
    "chain:verify": "node scripts/chain-test.mjs --browser",
    "chain:preflight": "node scripts/chain-preflight.mjs",
    "chain:estimate": "node scripts/chain-estimate.mjs",
    "verify:all": "pnpm verify && pnpm chain:verify && pnpm build",
    "motion:verify": "node scripts/motion-verify.mjs",
    "motion:record": "node scripts/motion-verify.mjs --record"
  },
  "devDependencies": {
    "playwright": "1.59.1",
    "typescript": "5.7.2"
  }
}
