{
  "name": "signalpass",
  "private": true,
  "version": "0.1.0",
  "description": "SignalPass — high-signal introductions for Monad builders",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "e2e": "node scripts/e2e.mjs",
    "v4:dev": "pnpm --filter @signalpass/web exec next dev -p 3004",
    "v4:verify": "node scripts/v4-verify.mjs",
    "verify": "pnpm -r typecheck && pnpm -r test && pnpm contracts:test && pnpm e2e",
    "dev": "pnpm --parallel --filter @signalpass/api --filter @signalpass/web dev",
    "contracts:build": "pnpm --filter @signalpass/contracts build",
    "contracts:test": "pnpm --filter @signalpass/contracts test",
    "api:dev": "pnpm --filter @signalpass/api dev"
  },
  "devDependencies": {
    "playwright": "1.59.1",
    "typescript": "5.7.2"
  }
}
