# Start with an allowlist. Runtime files, repository history and credentials do
# not enter the build context, even though the Dockerfile copies source folders.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!tsconfig.base.json
!apps/
!apps/web/
!apps/web/**
!packages/
!packages/core/
!packages/core/**
!services/
!services/api/
!services/api/**
!deploy/
!deploy/healthcheck.mjs

**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/secrets/**
**/node_modules/**
**/.next*/**
**/.data/**
**/.run/**
**/*.sqlite*
**/*.log
**/*.tsbuildinfo
**/next-env.d.ts
**/.impeccable/**
apps/web/public/models/**
