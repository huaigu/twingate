      "css": ".ds-interest{font-family:'Manrope Variable',sans-serif;display:inline-block;border:1px solid currentColor;border-radius:5px;font-size:10px;line-height:1.6;padding:4px 8px;color:#32442f}"
    },
    {
      "name": "Leaf profile",
      "kind": "card",
      "refersTo": "profile-leaf",
      "description": "Linked sample profile with a pastel field, initial avatar and interests.",
      "html": "<a class=\"ds-profile\" href=\"/builders/alice\"><div class=\"ds-profile-top\"><span class=\"ds-initial\">a.</span><span>Open to introductions</span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M6 18 18 6M6 6h12v12\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div><h3>Alice</h3><p class=\"ds-profile-role\">Making contracts easier to test.</p><p class=\"ds-profile-detail\">Building a deterministic simulation harness for Monad contracts. Looking for protocol engineers who have shipped.</p><div class=\"ds-profile-tags\"><span>Simulation</span><span>Protocol design</span><span>Monad</span></div><span class=\"ds-profile-sample\">Demo profile · @alice</span></a>",
      "css": ".ds-profile{font-family:'Manrope Variable',sans-serif;display:block;border-radius:12px;padding:28px 33px 23px;position:relative;background:#e8eddc;color:#32442f;line-height:1.6;text-decoration:none;transition:transform 250ms,box-shadow 250ms}.ds-profile:hover{transform:translateY(-4px);box-shadow:0 20px 30px -25px #23382e66}.ds-profile:focus-visible{outline:3px solid #264be6;outline-offset:5px;}.ds-profile-top{display:flex;align-items:center;gap:12px;font-size:11px}.ds-profile-top>svg{margin-left:auto}.ds-initial{display:inline-grid;place-items:center;width:43px;height:43px;background:#cbdaa7;border-radius:50%;font-size:23px;font-weight:660}.ds-profile h3{font-size:30px;font-weight:650;margin:25px 0 0;letter-spacing:-.03em}.ds-profile-role{font-size:19px;font-weight:570;margin:6px 0 0;letter-spacing:-.025em}.ds-profile-detail{font-size:15px;opacity:.85;line-height:1.8;margin:14px 0 0;max-width:48ch}.ds-profile-tags{display:flex;gap:7px;margin-top:25px;flex-wrap:wrap}.ds-profile-tags span{border:1px solid currentColor;border-radius:5px;font-size:10px;padding:4px 8px}.ds-profile-sample{display:block;margin-top:25px;font-size:10px}@media(max-width:900px){.ds-profile{padding:25px}.ds-profile-top{flex-wrap:wrap}.ds-profile-top>span:nth-child(2){font-size:9px}.ds-profile-role{font-size:17px}}@media(max-width:540px){.ds-profile{padding:23px}.ds-profile-top>span:nth-child(2){font-size:10px}.ds-profile h3{font-size:29px;margin-top:19px}.ds-profile-role{font-size:18px}.ds-profile-tags{margin-top:20px}.ds-profile-sample{margin-top:21px}}@media(prefers-reduced-motion:reduce){.ds-profile{transition:none}}"
    },
    {
      "name": "Introduction summary",
      "kind": "card",
      "refersTo": "introduction-summary",
      "description": "The initially selected illustrated summary, positioned above the preview tabs in the homepage.",
      "html": "<section class=\"ds-summary\" aria-label=\"Illustrated introduction summary\"><div class=\"ds-summary-meta\"><span class=\"ds-summary-mark\"><svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" fill=\"none\" aria-hidden=\"true\"><path d=\"M13 5 4 14v6l9 9V5Zm8 0 9 9v6l-9 9V5Z\" fill=\"currentColor\"/><circle cx=\"17\" cy=\"17\" r=\"2\" fill=\"currentColor\"/></svg></span><span>Alice &amp; Bob</span><span class=\"ds-summary-example\">Illustrated example</span></div><div class=\"ds-summary-content\"><h2>Common ground, found.</h2><p>Alice can help test Bob’s indexing pipeline. Bob brings the event expertise her simulator needs.</p></div><div class=\"ds-summary-bottom\"><span>Your agent brings you the useful part</span><a href=\"/introduce/bob\" aria-label=\"Try this introduction\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M6 18 18 6M6 6h12v12\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a></div></section>",
      "css": ".ds-summary{font-family:'Manrope Variable',sans-serif;padding:17px 21px 10px;background:#fffefb;color:#192727;border-radius:12px;box-shadow:0 18px 35px -24px #284b8170;line-height:1.6}.ds-summary-meta{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:680}.ds-summary-mark{display:inline-grid;place-items:center;color:#264be6}.ds-summary-mark svg{width:23px;height:23px}.ds-summary-example{font-size:11px;font-weight:500;color:#666d67;margin-left:auto}.ds-summary-content{min-height:101px;padding-top:10px}.ds-summary-content h2{font-family:inherit;font-size:19px;font-weight:650;letter-spacing:-.03em;margin:0 0 7px}.ds-summary-content p{font-size:14px;line-height:1.7;color:#52615f;max-width:48ch;margin:0}.ds-summary-bottom{border-top:1px solid #e4e5dc;display:flex;align-items:center;justify-content:space-between;margin-top:8px;padding-top:6px;gap:8px}.ds-summary-bottom>span{font-size:11px;color:#52665c}.ds-summary-bottom a{display:inline-grid;place-items:center;width:36px;height:36px;color:#264be6;border-radius:5px;text-decoration:none}.ds-summary-bottom a:hover{background:#e9edf9}.ds-summary-bottom a:focus-visible{outline:3px solid #264be6;outline-offset:5px;}@media(max-width:1150px){.ds-summary{padding-inline:17px}}@media(max-width:540px){.ds-summary{padding:14px 16px 8px}.ds-summary-meta,.ds-summary-example,.ds-summary-bottom>span{font-size:10px}.ds-summary-content{min-height:119px}.ds-summary-content h2{font-size:17px}.ds-summary-content p{font-size:13px}}"
    },
    {
