{
  "name": "@signalpass/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-ui.mjs --dev",
    "build": "pnpm css:build && next build",
    "css:build": "node scripts/build-ui.mjs",
    "css:check": "node scripts/build-ui.mjs --check",
    "css:watch": "node scripts/build-ui.mjs --watch",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit"
