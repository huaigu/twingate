    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "daisyui": "5.7.47",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2"
  }
}
